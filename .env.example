# BookShelf — Environment Variables
# Copy to .env and fill in values

# ─── App ─────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=["https://app.bookshelf.app"]

# ─── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://bookshelf:CHANGE_ME@localhost:5432/bookshelf

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AI / LLM ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_BOOKS_API_KEY=AIza...

# ─── AWS S3 ──────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=bookshelf-uploads

# ─── Stripe ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_READER_PRICE_ID=price_...
STRIPE_COLLECTOR_PRICE_ID=price_...
STRIPE_ARCHIVIST_PRICE_ID=price_...

# ─── Email ───────────────────────────────────────────────────────
SENDGRID_API_KEY=SG....
FROM_EMAIL=noreply@bookshelf.app

# ─── Admin ───────────────────────────────────────────────────────
ADMIN_EMAIL=admin@bookshelf.app
